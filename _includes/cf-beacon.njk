<script>
(function () {
  var KEY = "mcNoBeacon";
  try {
    var q = new URLSearchParams(location.search);
    if (q.has("notrack")) {
      if (q.get("notrack") === "0") { localStorage.removeItem(KEY); }
      else { localStorage.setItem(KEY, "1"); }
    }
    if (localStorage.getItem(KEY) === "1") {
      console.log("[meguri] analytics off (this browser)");
      return;
    }
  } catch (e) {}
  var s = document.createElement("script");
  s.src = "https://static.cloudflareinsights.com/beacon.min.js";
  s.defer = true;
  s.setAttribute("data-cf-beacon", '{"token": "15b37c037ea94303a8d315c693380a78"}');
  document.head.appendChild(s);
})();
</script>
